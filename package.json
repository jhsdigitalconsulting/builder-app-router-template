{
  "name": "@jhs129/builder-app-router-template",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "JHS Digital Consulting, LLC (https://www.jhsdigitalconsulting.com)",
  "homepage": "https://www.jhsdigitalconsulting.com",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "configure": "node scripts/setup.mjs",
    "build": "turbo run build --filter=!storybook-app",
    "build-all": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "dev:app-0": "turbo run dev --filter=app-0",
    "dev:storybook": "turbo run storybook --filter=storybook-app",
    "build:app-0": "turbo run build --filter=app-0",
    "build:storybook": "turbo run build-storybook --filter=storybook-app",
    "build:plugins": "pnpm --filter builder-plugins build && pnpm --filter @jhsdc/builder-input-types build",
    "dev:plugin": "pnpm --filter @jhsdc/builder-input-types dev"
  },
  "dependencies": {
    "graphql-request": "^7.2.0"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "isolated-vm": "6.1.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "js-yaml@4": "^4.3.2",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "source-map-js": "^1.2.2",
      "shell-quote": "^1.11.0",
      "webpack-dev-server@5": "^5.2.6",
      "launch-editor": "^2.14.2",
      "follow-redirects": "^1.16.1",
      "proxy-addr": "^2.0.8",
      "compression": "^1.8.2",
      "body-parser@1": "^1.20.6",
      "fast-uri@3": "^3.1.8",
      "nanoid@3": "^3.3.18",
      "qs@6": "^6.16.0",
      "postcss-selector-parser@7": "^7.1.6",
      "postcss@8": "^8.5.23"
    }
  }
}
